{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "jupyter.kernels.excludePythonEnvironments": ["/usr/local/python/3.14.2/bin/python", "/home/codespace/.python/current/bin/python"],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/.venv", "**/results", "**/figures", "**/__pycache__", "**/.ipynb_checkpoints",
    "01_Original_Colab"
  ],
  "files.watcherExclude": {
    "**/.venv/**": true, "**/results/**": true, "**/figures/**": true
  }
}
